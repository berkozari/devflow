# syntax=docker/dockerfile:1.7
# Run from monorepo root: docker build -f apps/api/Dockerfile.migrate -t devflow-migrate:dev015 .
# Separate one-off Prisma migration image, built from the SAME git revision as API and Web.
FROM node:24-bookworm-slim
WORKDIR /workspace
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
WORKDIR /workspace/apps/api
ENV NODE_ENV=production
CMD ["pnpm", "exec", "prisma", "migrate", "deploy"]
