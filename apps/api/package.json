{
    "name": "@devflow/api",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "postinstall": "prisma skills sync || exit 0",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:integration": "vitest run tests/integration"
    },
    "dependencies": {
        "@prisma/adapter-pg": "7.10.0",
        "@prisma/client": "7.10.0",
        "argon2": "^0.45.2",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.0.0",
        "express": "^5.0.0",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.3",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.0",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.0.0",
        "@types/supertest": "^7.2.1",
        "@vitest/coverage-v8": "5.1.0",
        "prisma": "7.10.0",
        "supertest": "^7.3.2",
        "tsx": "^4.0.0",
        "typescript": "^5.9.0",
        "vitest": "^5.1.0"
    }
}