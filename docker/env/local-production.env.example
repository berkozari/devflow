# DEV-015 / Local-production only. Run generate-local-production-env.py to create
# docker/env/local-production.env with unique random values; do not commit it.
# Avoid URL punctuation in passwords: the generator uses hex strings.
LOCAL_PROD_DB_USER=devflow_localprod
LOCAL_PROD_DB_NAME=devflow_localprod
LOCAL_PROD_DB_PASSWORD=REPLACE_ME
LOCAL_PROD_REDIS_PASSWORD=REPLACE_ME
LOCAL_PROD_JWT_SECRET=REPLACE_ME
LOCAL_PROD_CSRF_SECRET=REPLACE_ME
